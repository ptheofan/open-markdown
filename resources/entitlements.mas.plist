<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Application identifier - must match provisioning profile -->
    <key>com.apple.application-identifier</key>
    <string>KGRHL55T3R.com.aralu.markdown-viewer</string>
    <!-- App Sandbox - REQUIRED for Mac App Store -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Application groups - required for Electron IPC (Mach port rendezvous) between main and helper processes -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>KGRHL55T3R.com.aralu.markdown-viewer</string>
        <string>group.com.aralu.markdown-viewer</string>
    </array>
    <!-- JIT - Electron/V8 needs this; Apple grants temporary exception for Electron apps -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Unsigned executable memory - needed by Electron's V8 engine -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Disable library validation - needed for Electron's native modules -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- User-selected files read/write - for opening markdown files via open dialog -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Bookmarks - to persist access to user-selected files across app restarts (for file watching) -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- Network client - for loading remote images/resources in markdown -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Network server - Google's OAuth flow for desktop apps redirects to a
         loopback HTTP server we start on a random port. Without this the
         sandbox denies listen() with EPERM and sign-in cannot complete.
         Google no longer supports custom URI schemes, so loopback is the only
         option. Nothing is reachable from outside: the socket is bound for the
         seconds the browser round-trip takes and closed afterwards. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Keychain access group - required for safeStorage to persist its
         Keychain ACL inside the sandbox without prompting on every launch.
         Used by GoogleAuthService to encrypt Google OAuth tokens at rest.

         The team prefix is written out in full, as it is for
         application-identifier and application-groups above.
         $(AppIdentifierPrefix) is an Xcode build variable, and nothing in this
         pipeline expands it - electron-osx-sign copies this plist verbatim, so
         the literal text would ship as the group name and App Store Connect
         rejects it as not matching the provisioning profile. -->
    <key>keychain-access-groups</key>
    <array>
        <string>KGRHL55T3R.com.aralu.markdown-viewer</string>
    </array>
</dict>
</plist>
